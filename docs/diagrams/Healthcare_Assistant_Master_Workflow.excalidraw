      "seed": 71562,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "text": "\u2022 If Role == 'patient' \u2794 Redirects to /app/patient (PatientDashboard)\n\u2022 If Role == 'healthcare_worker' \u2794 Redirects to /app/asha (AshaDashboard)\n\u2022 If Role == 'doctor' \u2794 Redirects to /app/doctor (DoctorDashboard)\n\u2022 If Role == 'caregiver' \u2794 Redirects to /app/caregiver (CaregiverDashboard)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "\u2022 If Role == 'patient' \u2794 Redirects to /app/patient (PatientDashboard)\n\u2022 If Role == 'healthcare_worker' \u2794 Redirects to /app/asha (AshaDashboard)\n\u2022 If Role == 'doctor' \u2794 Redirects to /app/doctor (DoctorDashboard)\n\u2022 If Role == 'caregiver' \u2794 Redirects to /app/caregiver (CaregiverDashboard)",
